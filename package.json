{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-media.mjs",
    "prebuild": "node scripts/prepare-media.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:firebase": "node tests/firebase.mjs",
    "test:auth": "node tests/google-auth.mjs",
    "test:payments": "node tests/payments.mjs && node tests/billing-ui.mjs && node tests/paid-access.mjs",
    "test:payments:emulator": "node scripts/test-cloud.mjs --payments",
    "check:payments": "node scripts/check-payments.mjs",
    "test": "node tests/editor.mjs && node tests/lottie.mjs && node tests/render.mjs && node tests/interactions.mjs && node tests/dashboard-preview.mjs && node tests/media.mjs && node tests/media-ui.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test:cloud": "node scripts/test-cloud.mjs",
    "test:storage": "node tests/storage-api.mjs",
    "test:runtime": "node --no-experimental-require-module tests/server-runtime.mjs",
    "test:project-actions": "node tests/project-actions-ui.mjs",
    "test:vector": "node tests/vectorization.mjs",
    "test:png-svg": "node tests/png-svg-ui.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@visioncortex/vtracer": "^1.0.0-alpha.4",
    "clsx": "2.1.1",
    "color-string": "^2.1.4",
    "dodopayments": "^2.53.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^13.4.4",
    "gifuct-js": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.48.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.4",
    "svgpath": "^2.6.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
