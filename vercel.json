{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/storage.mjs": { "maxDuration": 300, "excludeFiles": "{public,dist,tests}/**" } },
  "routes": [
    { "src": "/api/storage/([A-Za-z0-9_-]+(?:/(?:copy|uploads))?)", "dest": "/api/storage?__storageRoute=$1" },
    { "src": "/api/storage(?:/.*)?", "dest": "/api/storage" },
    { "handle": "filesystem" },
    { "src": "/(?:privacy|terms|dashboard|editor(?:/[^/]+)?)?/?$", "dest": "/index.html" }
  ]
}
