rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // Billing fields can only be written by trusted Admin/webhook code.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid}/projects/{projectId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function paid() {
        let billing = get(/databases/$(database)/documents/users/$(uid)).data;
        return (billing.plan == 'pro' && billing.subscriptionStatus == 'active')
          || (billing.plan == 'lifetime' && billing.lifetime == true);
      }
      // Owners retain recovery/read/delete access; paid creation/editing is enforced in rules.
      allow read, delete: if owner();
      allow create: if owner() && paid() && request.resource.data.projectId == projectId
        && request.resource.data.ownerId == uid;
      allow update: if owner() && paid() && request.resource.data.projectId == projectId
        && request.resource.data.ownerId == uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
