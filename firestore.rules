rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // Billing fields can only be written by trusted Admin/webhook code.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid}/projects/{projectId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function trialProject() {
        return get(/databases/$(database)/documents/users/$(uid)).data.freeTrialEnabled == true
          && exists(/databases/$(database)/documents/users/$(uid)/trialProjects/$(projectId));
      }
      function paid() {
        let billing = get(/databases/$(database)/documents/users/$(uid)).data;
        return (billing.get('plan', '') == 'pro' && billing.get('subscriptionStatus', '') == 'active')
          || (billing.get('plan', '') == 'lifetime' && billing.get('lifetime', false) == true);
      }
      // Project grants and trial counters are server-only. Owners retain recovery access.
      allow read, delete: if owner();
      allow create: if owner() && (paid() || trialProject()) && request.resource.data.projectId == projectId
        && request.resource.data.ownerId == uid;
      allow update: if owner() && (paid() || trialProject()) && request.resource.data.projectId == projectId
        && request.resource.data.ownerId == uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
